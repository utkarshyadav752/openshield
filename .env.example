# OLLAMA_BASE_URL: Local Ollama server address running on your computer.
# No external or paid cloud AI API keys are used.
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_MODEL: Local AI model executed by Ollama.
OLLAMA_MODEL="gemma3:1b"

# APP_URL: Local application URL (defaults to http://localhost:3000)
APP_URL="http://localhost:3000"

